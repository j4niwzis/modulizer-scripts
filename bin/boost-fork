#!/usr/bin/env bash
# boost-fork <lib>
#
# Assemble a publishable fork of a Boost library converted to C++20 modules,
# then build and test it both ways.
#
# The fork is the upstream repository with its headers replaced by generated
# ones and the module interface units added alongside. It builds either way:
#
#   cmake -B build                              classic, header-only
#   cmake -B build -DBOOST_<LIB>_MODULES=ON     module units and imports
#
# and the library's own tests and examples build and run under both.
#
# Tests that do not compile against UPSTREAM are left out of the generated
# build: they want a Boost library this tree has no way to provide, or they are
# compile-fail tests. Only what worked before the conversion is held to working
# after it.
#
# Options:
#   --skip-check   assemble the fork without building it, for when it is only
#                  needed as a sibling of another fork's build
#   --keep-logs    leave the generator and build logs in the fork
#
# Environment: MZ_SRC, MZ_DEPS, MZ_FORKS, MZ_MODULIZER, MZ_CMAKE, MZ_CXX, MZ_JOBS

source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
mz_handle_help "${1:-}"

SKIP_CHECK=0 KEEP_LOGS=0 LIB=
while [ $# -gt 0 ]; do
  case "$1" in
    --skip-check) SKIP_CHECK=1 ;;
    --keep-logs)  KEEP_LOGS=1 ;;
    -*)           die "unknown option: $1 (try --help)" ;;
    *)            [ -z "$LIB" ] || die "one library at a time"; LIB=$1 ;;
  esac
  shift
done
[ -n "$LIB" ] || mz_usage 1

mz_require_repo "$LIB"
[ -d "$MZ_DEPS" ] || die "no dependency tree in $MZ_DEPS; run: boost-deps $LIB"

REPO=$(mz_repo_dir "$LIB")
FORK=$(mz_fork_dir "$LIB")
MODULIZER=$(mz_modulizer)
CMAKE=$(mz_cmake)
CXX=$(mz_cxx)
JOBS=$(mz_jobs)
MODULE=$(mz_module "$LIB")
PREFIX=$(mz_prefix "$LIB")
UPPER=BOOST_$(mz_upper "$LIB")

# Include paths relative to the fork, so the include form the tool records is
# the one the headers are actually written with (`boost/describe.hpp`, not
# `describe.hpp`).
ARGS="-x c++ -std=c++20 -Wno-pragma-once-outside-header -Iinclude -I$MZ_DEPS"

# ---- which tests and examples are worth carrying -------------------------
# Compiled against the untouched upstream headers. A test that cannot build
# there says nothing about the conversion.
#
# Compiled AND linked, not merely syntax-checked: a syntax check passes for the
# helper translation units that have no `main` of their own, and those cannot be
# test executables.
# Two different questions, and conflating them hides both.
#
# Whether a test COMPILES against untouched upstream says whether the
# environment is sound: when the shared dependency tree is staged incompletely
# almost nothing compiles, and a conversion measured against the remainder
# measures nothing.
#
# Whether it also PASSES says what the conversion is answerable for. A test
# that already fails upstream -- several here abort on purpose -- counted among
# the fork's results reads as damage the conversion did.
probe() { # $1 = file, $2 = "compile" or "pass"
  local out rc
  out=$(mktemp)
  # The flags the fork is built with, so a test kept here is one the build can
  # actually compile: a few of Boost's constexpr tests only fail under -O3.
  if "$CXX" -std=c++20 -O3 -DNDEBUG -I"$REPO/include" -I"$MZ_DEPS" "$1" \
       ${UPSTREAM_LIB:+"$UPSTREAM_LIB"} -o "$out" >/dev/null 2>&1; then
    if [ "$2" = compile ]; then rc=0; else "$out" >/dev/null 2>&1; rc=$?; fi
  else
    rc=1
  fi
  rm -f "$out"
  return $rc
}
# A library with sources of its own is not header-only: its tests do not link
# without them, and every probe then fails at the link step for a reason that
# has nothing to do with the conversion.
UPSTREAM_LIB=
if compgen -G "$REPO/src/*.cpp" > /dev/null; then
  _objs=$(mktemp -d)
  for c in "$REPO"/src/*.cpp; do
    "$CXX" -std=c++20 -O3 -DNDEBUG -I"$REPO/include" -I"$MZ_DEPS" \
      -c "$c" -o "$_objs/$(basename "${c%.cpp}").o" >/dev/null 2>&1 || true
  done
  if ar rcs "$_objs/libupstream.a" "$_objs"/*.o 2>/dev/null; then
    UPSTREAM_LIB=$_objs/libupstream.a
    log "   $LIB has $(ls "$REPO"/src/*.cpp | wc -l) sources of its own; tests link against them"
  fi
fi

export -f probe
export CXX REPO MZ_DEPS UPSTREAM_LIB

cd "$REPO"
CAND=()
for d in test example; do
  [ -d "$d" ] || continue
  for f in "$d"/*.cpp; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in
      *fail*)                continue ;;  # compile-fail tests
      check_cmake_version*)  continue ;;  # reads the repo's own CMakeLists
    esac
    CAND+=("$f")
  done
done

COMPILES=() KEEP=()
if [ ${#CAND[@]} -gt 0 ]; then
  while read -r f; do [ -n "$f" ] && COMPILES+=("$f"); done < <(
    printf '%s\n' "${CAND[@]}" |
      xargs -P "$JOBS" -I{} bash -c 'probe {} compile && echo {}' | sort || true)
  if [ ${#COMPILES[@]} -gt 0 ]; then
    while read -r f; do [ -n "$f" ] && KEEP+=("$f"); done < <(
      printf '%s\n' "${COMPILES[@]}" |
        xargs -P "$JOBS" -I{} bash -c 'probe {} pass && echo {}' | sort || true)
  fi
fi
log "== $LIB: ${#CAND[@]} candidates, ${#COMPILES[@]} compile, ${#KEEP[@]} pass against upstream"
if [ $(( ${#COMPILES[@]} + ${#KEEP[@]} )) -gt 0 ] &&
   [ ${#COMPILES[@]} -ne ${#KEEP[@]} ]; then
  log "   $(( ${#COMPILES[@]} - ${#KEEP[@]} )) already fail upstream and are left out"
fi
# A collapse here is the environment, not the library: a dependency tree that
# was staged incompletely makes almost every test fail to compile against
# UNTOUCHED upstream headers, and the run then reports a conversion result that
# measures nothing.
if [ ${#CAND[@]} -gt 8 ] && [ $(( ${#COMPILES[@]} * 2 )) -lt ${#CAND[@]} ]; then
  die "only ${#COMPILES[@]} of ${#CAND[@]} COMPILE against upstream; the dependency tree in $MZ_DEPS looks incomplete (re-run boost-deps $LIB)"
fi

# ---- the fork tree -------------------------------------------------------
rm -rf "$FORK"
mkdir -p "$(dirname "$FORK")"
cp -a "$REPO" "$FORK"
rm -rf "$FORK/.git" "$FORK/build" "$FORK/CMakeLists.txt" "$FORK/test/CMakeLists.txt"

# ---- patches --------------------------------------------------------------
# A conversion changes how many lines stand above a consumer's code, so a test
# that names a source line outright fails by exactly that shift. Those tests
# are patched to ask __LINE__ for the line they are about. Each patch is
# checked against UNPATCHED upstream too, so it adapts a test rather than
# bending one into passing.
PATCHES=$MZ_HOME/patches/$LIB
# Tests that cannot hold as modules, named with their reason. Reported rather
# than dropped quietly: a build that silently runs fewer tests reads as a
# passing one.
MODULAR_SKIP=""
if [ -f "$PATCHES/modular-skip.txt" ]; then
  MODULAR_SKIP=$(grep -vE '^\s*(#|$)' "$PATCHES/modular-skip.txt" || true)
  [ -n "$MODULAR_SKIP" ] &&
    log "   classic-only ($(echo "$MODULAR_SKIP" | wc -l)): $(echo $MODULAR_SKIP | tr '\n' ' ')"
fi
if [ -d "$PATCHES" ]; then
  for p in "$PATCHES"/*.patch; do
    [ -e "$p" ] || continue
    if patch -s -p1 -d "$FORK" < "$p"; then
      log "   patched: $(basename "$p")"
    else
      die "$(basename "$p") does not apply to $LIB; it was written for a different upstream"
    fi
  done
fi

STAGE=$(mktemp -d)
cleanup() { rm -rf "$STAGE"; }
trap cleanup EXIT

cd "$FORK"
HDRS=()
while read -r h; do HDRS+=("$h"); done < <(find include -name '*.hpp' | sort)
[ ${#HDRS[@]} -gt 0 ] || die "$LIB has no headers under include/"

# The tests reach the library's internals. Traced as consumers, the entities
# they name are exported from the modules that define them.
ics=()
for f in ${KEEP[@]+"${KEEP[@]}"}; do ics+=("--internal-consumer-source=$f"); done

# The libraries already converted, as the modules they generated. One
# --module-replaces per module, each naming every header that module provides,
# so an include of any of them becomes that import and the narrowest module
# covering a header is the one chosen. Guarded by the provider's own macro, so
# a fork can be built against a modular dependency or a classic one without the
# two decisions being tied together.
sibs=()
while read -r s; do
  [ "$s" = "$LIB" ] && continue
  sf=$(mz_fork_dir "$s")
  [ -d "$sf/modules" ] || continue   # not converted yet in this tree
  while read -r flag; do
    [ -n "$flag" ] && sibs+=("$flag")
  done < <("$MZ_BIN/module-replaces" --guard "$(mz_prefix "$s")_IMPORT_MODULES" \
             --macros "$sf/include" "$sf/modules" 2>/dev/null)
done < <(mz_libraries)
[ ${#sibs[@]} -gt 0 ] && info "   ${#sibs[@]} modules provided by converted dependencies"

set +e
"$MODULIZER" --full --module-name="$MODULE" --macro-prefix="$PREFIX" \
  --output-dir="$STAGE" --internal-mode=both --export-all \
  ${ics[@]+"${ics[@]}"} ${sibs[@]+"${sibs[@]}"} "${HDRS[@]}" -- $ARGS \
  > "$FORK/.gen.log" 2>&1
genrc=$?
set -e
[ "$genrc" = 0 ] || warn "$LIB: generator exited $genrc (see $FORK/.gen.log)"
grep -E "include fragments, not modules|headers parse only" "$FORK/.gen.log" |
  sed 's/^/   /' || true

# ---- install -------------------------------------------------------------
# Generated headers replace the originals where the include form says they
# should; the interface units go in modules/.
rm -rf "$FORK/modules"
mkdir -p "$FORK/modules"
(cd "$STAGE" && find . \( -name '*.hpp' -o -name '*.h' \) -not -path './impl/*' |
  while read -r f; do
    rel=${f#./}
    case "$rel" in
      boost/*) dst="$FORK/include/$rel" ;;
      *)       dst="$FORK/include/boost/$rel" ;;
    esac
    mkdir -p "$(dirname "$dst")"
    cp "$f" "$dst"
  done)
(cd "$STAGE" && find . -name '*.cc' -not -path './impl/*' |
  while read -r f; do
    mkdir -p "$FORK/modules/$(dirname "$f")"
    cp "$f" "$FORK/modules/$f"
  done)

# ---- dual-mode tests -----------------------------------------------------
# The tests and examples keep their includes for the classic build; where the
# module macro is defined those are replaced by imports.
if [ ${#KEEP[@]} -gt 0 ]; then
  lhs=()
  for f in "${HDRS[@]}"; do lhs+=("--library-header=$f"); done
  set +e
  "$MODULIZER" --consumers --dual-consumers --module-name="$MODULE" \
    --macro-prefix="$PREFIX" ${sibs[@]+"${sibs[@]}"} "${lhs[@]}" "${KEEP[@]}" -- $ARGS \
    > "$FORK/.consumers.log" 2>&1
  set -e
fi

# ---- CMake ---------------------------------------------------------------
{
cat <<EOF
cmake_minimum_required(VERSION 3.28 FATAL_ERROR)
project(boost_${LIB} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

option(${UPPER}_MODULES "Build the library as C++20 modules" OFF)
option(${UPPER}_BUILD_TESTS "Build the tests and examples" ON)

# Where the rest of Boost's headers live. The generated headers keep including
# the libraries this one depends on, which are not part of this fork.
set(BOOST_DEPS_INCLUDE "" CACHE PATH "Include directory for the other Boost libraries")

if(${UPPER}_MODULES)

  file(GLOB_RECURSE ${LIB}_units CONFIGURE_DEPENDS "\${CMAKE_CURRENT_SOURCE_DIR}/modules/*.cc")
  add_library(boost_${LIB} STATIC \${${LIB}_units})
  target_sources(boost_${LIB} PUBLIC FILE_SET CXX_MODULES FILES \${${LIB}_units})
  # ${PREFIX}_USE_MODULES is deliberately NOT defined here: each unit defines it
  # for itself right before including its header, and defined for anyone else it
  # would take from the headers the includes a consumer still needs.
  # ${PREFIX}_IMPORT_MODULES is the consumer-side switch, set on the tests below.

else()

  add_library(boost_${LIB} INTERFACE)

endif()

# Other converted forks to build modularly alongside this one. Each is added to
# the module target and switched on by its own macro, which is what makes the
# choice per-library rather than all-or-nothing.
set(BOOST_SIBLING_FORKS "" CACHE STRING "Paths to other converted Boost forks")
if(${UPPER}_MODULES)
  foreach(_sf IN LISTS BOOST_SIBLING_FORKS)
    get_filename_component(_sn "\${_sf}" NAME)
    string(TOUPPER "\${_sn}" _SN)
    file(GLOB_RECURSE _su CONFIGURE_DEPENDS "\${_sf}/modules/*.cc")
    # BASE_DIRS: the sibling's units live outside this project's source tree.
    target_sources(boost_${LIB} PUBLIC
      FILE_SET CXX_MODULES BASE_DIRS "\${_sf}/modules" FILES \${_su})
    # Ahead of BOOST_DEPS_INCLUDE, so the sibling's generated headers win over
    # the originals still sitting in the dependency tree.
    target_include_directories(boost_${LIB} BEFORE PUBLIC "\${_sf}/include")
    target_compile_definitions(boost_${LIB} PUBLIC BOOST_\${_SN}X_IMPORT_MODULES=1)
  endforeach()
endif()

add_library(Boost::${LIB} ALIAS boost_${LIB})

if(${UPPER}_MODULES)
  target_include_directories(boost_${LIB} PUBLIC "\${CMAKE_CURRENT_SOURCE_DIR}/include")
  if(BOOST_DEPS_INCLUDE)
    target_include_directories(boost_${LIB} PUBLIC "\${BOOST_DEPS_INCLUDE}")
  endif()
elseif(${LIB}_sources)
  target_include_directories(boost_${LIB} PUBLIC "\${CMAKE_CURRENT_SOURCE_DIR}/include")
  if(BOOST_DEPS_INCLUDE)
    target_include_directories(boost_${LIB} PUBLIC "\${BOOST_DEPS_INCLUDE}")
  endif()
else()
  target_include_directories(boost_${LIB} INTERFACE "\${CMAKE_CURRENT_SOURCE_DIR}/include")
  if(BOOST_DEPS_INCLUDE)
    target_include_directories(boost_${LIB} INTERFACE "\${BOOST_DEPS_INCLUDE}")
  endif()
endif()

if(${UPPER}_BUILD_TESTS)
  enable_testing()
EOF
for f in ${KEEP[@]+"${KEEP[@]}"}; do
  name=$(echo "${f%.cpp}" | tr '/' '_')
  # A test the library cannot pass as modules is built classically only; see
  # patches/<lib>/modular-skip.txt for which and why.
  if [ -n "${MODULAR_SKIP:-}" ] && printf '%s\n' $MODULAR_SKIP | grep -qxF "$f"; then
    echo "  if(NOT ${UPPER}_MODULES)"
    echo "    add_executable($name \"\${CMAKE_CURRENT_SOURCE_DIR}/$f\")"
    echo "    target_link_libraries($name PRIVATE boost_${LIB})"
    echo "    add_test(NAME $name COMMAND $name)"
    echo "  endif()"
    continue
  fi
  echo "  add_executable($name \"\${CMAKE_CURRENT_SOURCE_DIR}/$f\")"
  echo "  target_link_libraries($name PRIVATE boost_${LIB})"
  echo "  if(${UPPER}_MODULES)"
  echo "    target_compile_definitions($name PRIVATE ${PREFIX}_IMPORT_MODULES=1)"
  echo "  endif()"
  echo "  add_test(NAME $name COMMAND $name)"
done
echo "endif()"
} > "$FORK/CMakeLists.txt"

if [ "$SKIP_CHECK" = 1 ]; then
  log "   assembled (checks skipped)"
  exit 0
fi

# ---- build and test, both ways -------------------------------------------
check() { # $1 = mode name, $2... = extra cmake args
  local mode=$1; shift
  local b="$FORK/.build-$mode" result failed
  rm -rf "$b"
  if ! "$CMAKE" -S "$FORK" -B "$b" -G Ninja -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_CXX_COMPILER="$CXX" -DBOOST_DEPS_INCLUDE="$MZ_DEPS" "$@" \
       > "$FORK/.cfg-$mode.log" 2>&1; then
    log "   $mode: configure failed (see $FORK/.cfg-$mode.log)"
    return 1
  fi
  # -k 0 keeps going after the first failure, so one broken test does not hide
  # the state of the rest.
  if "$CMAKE" --build "$b" -j"$JOBS" -- -k 0 > "$FORK/.build-$mode.log" 2>&1; then
    result=$(cd "$b" && ctest -j"$JOBS" 2>&1 |
             grep -E "tests passed|tests failed" | head -1)
    log "   $mode: built, $result"
    [ "$KEEP_LOGS" = 1 ] || rm -rf "$b"
    case "$result" in *"100% tests passed"*) return 0 ;; *) return 1 ;; esac
  fi
  # The build tree is not needed once its result is known, and the modular-deps
  # one holds every sibling's module units as well. Fifteen libraries times
  # three configurations fills a disk, and a build that runs out of space fails
  # in ways that look like anything but.
  failed=$(grep "^FAILED:" "$FORK/.build-$mode.log" |
           grep -oE "CMakeFiles/[a-zA-Z0-9_]+\.dir" |
           sed 's|CMakeFiles/||; s|\.dir||' | sort -u | tr '\n' ' ')
  log "   $mode: $(echo "$failed" | wc -w) targets failed"
  log "     $(echo "$failed" | cut -c1-200)"
  grep -m2 "error:" "$FORK/.build-$mode.log" | sed 's/^/     /' >&2 || true
  [ "$KEEP_LOGS" = 1 ] || rm -rf "$b"
  return 1
}

# The converted forks of this library's own dependencies, for the third
# configuration. Each is added to the module target and switched on by its own
# macro, so what is proven is the arrangement a user actually wants: this
# library as modules, built against dependencies that are modules too.
siblings=()
while read -r s; do
  [ "$s" = "$LIB" ] && continue
  sf=$(mz_fork_dir "$s")
  [ -d "$sf/modules" ] && siblings+=("$sf")
done < <(mz_libraries)

rc=0
check classic || rc=1
check modular "-D${UPPER}_MODULES=ON" || rc=1
# Against modular dependencies. This is where a module's global module fragment
# stops covering for it: the fragment is pruned to what is decl-reachable from
# the exported declarations, so an operator found only by ADL is there while a
# dependency is a textual include and gone once it is a module.
if [ ${#siblings[@]} -gt 0 ]; then
  log "   with ${#siblings[@]} modular dependencies: $(basename -a "${siblings[@]}" | tr '\n' ' ')"
  check modular-deps "-D${UPPER}_MODULES=ON" \
    "-DBOOST_SIBLING_FORKS=$(IFS=';'; echo "${siblings[*]}")" || rc=1
else
  log "   no converted dependencies to build against"
fi

if [ "$KEEP_LOGS" = 0 ] && [ "$rc" = 0 ]; then
  rm -f "$FORK"/.gen.log "$FORK"/.consumers.log "$FORK"/.cfg-*.log "$FORK"/.build-*.log
  rm -rf "$FORK"/.build-classic "$FORK"/.build-modular
fi
exit $rc
